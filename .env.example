# ==============================================================================
# Telegram & Linux AI Ops Sentinel - Environment Configuration Template
# Copy this file to .env and populate your actual secrets and configuration values.
# ==============================================================================

# Telegram Bot Credentials
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Authorized Telegram User IDs (Comma-separated integers)
# Only these Telegram users will be permitted to run monitoring & restart commands.
# To find your ID, message @userinfobot on Telegram.
AUTHORIZED_USER_IDS=123456789,987654321

# Google Gemini API Key (Optional but recommended for AI Log Root-Cause Analysis)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyD-YourGeminiApiKeyHere

# Gemini Model Selection (e.g., gemini-1.5-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Services Configuration
# MONITORED_SERVICES: Comma-separated systemd services to poll during background health checks
MONITORED_SERVICES=nginx,redis,postgresql,ops-sentinel

# ALLOWED_SERVICES: Whitelist of services that admins are authorized to restart via /restart
ALLOWED_SERVICES=nginx,redis,postgresql,docker,ops-sentinel,apache2,mysql,mongodb

# Health Check Settings
# Interval in seconds between automated health & service availability pings
HEALTH_CHECK_INTERVAL_SEC=60

# Resource Alert Thresholds (Percentages 1-100)
CPU_ALERT_THRESHOLD=90.0
RAM_ALERT_THRESHOLD=88.0
DISK_ALERT_THRESHOLD=92.0

# Automatic Recovery
# If true, attempts safe automated restart when a monitored service transitions to failed
AUTO_RESTART_ON_FAILURE=false

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
